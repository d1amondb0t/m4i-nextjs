# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# qdrant
/qdrant_storage/
# calibration corpus PDFs (re-fetch with calibration/download-corpus.mjs);
# the manifest and fitted results stay tracked
/calibration/corpus/*/

# calibration stage caches: regenerable, and they carry full chunk text
/calibration/results/retrieval.json
/calibration/results/labels.json
/calibration/results/*.log

# Keep the experiment report and compact stage results; ignore checkpoints.
/calibration/results/experiment/*
!/calibration/results/experiment/experiment-report.md
!/calibration/results/experiment/stage1-metrics.json
!/calibration/results/experiment/stage2-metrics.json
!/calibration/results/experiment/stage3-calibration.json
!/calibration/results/experiment/stage4-judge-agreement.json
!/calibration/results/experiment/stage5-operating-point.json

# New review inference cache contains full corpus text; compact metrics stay tracked.
/calibration/results/review/live-cache-*.json*
/calibration/results/review/*.log
/calibration/results/review/depth-cache-*.json*

/dataset/*
