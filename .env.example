# Ollama defaults
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=hf.co/CompendiumLabs/bge-base-en-v1.5-gguf

#MAC
# OLLAMA_GENERATION_MODEL=hf.co/bartowski/Llama-3.2-1B-Instruct-GGUF
#WIN
#OLLAMA_GENERATION_MODEL=qwen3.5:9b-q4_K_M

OLLAMA_EMBED_BATCH_SIZE=16
OLLAMA_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Local Qdrant defaults
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_test

# For Qdrant Cloud, comment out QDRANT_HOST/QDRANT_PORT and set both values.
# QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
# QDRANT_API_KEY=

# Optional generation settings
RAG_PROMPT_PATH=prompts/grounded.txt
RAG_MAX_CONTEXT_WORDS=1200

# Reranker. The hierarchy pipeline always reranks; the default runs
# mxbai-rerank-xsmall-v1 in-process.
# Document questions (/api/rag) are reranked too. With the ollama runtime,
# Ollama swaps the reranker and the generation model on every question unless
# both fit in VRAM together; RAG_RERANKING=false uses the hybrid ranking alone.
# RAG_RERANKING=false
# To use zerank-2 through Ollama, build the score-head model described in
# scripts/build_zerank_ollama.py (ollama list must show zerank-2-score), then
# uncomment:
# RERANKING_RUNTIME=ollama
# RERANKING_MODEL=zerank-2-score
